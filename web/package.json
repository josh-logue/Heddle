{
  "name": "heddle-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Heddle: map branching and converging story paths.",
  "author": "Joshua",
  "homepage": "https://github.com/josh-logue/Heddle",
  "main": "desktop/main.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "help": "node scripts/help.ts",
    "desktop": "npm run build && electron desktop/main.ts",
    "desktop:dev": "node desktop/dev.ts",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "package": "npm run build && electron-builder --win --publish never",
    "test:packaged": "node desktop/test-packaged.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
